# Wanderlore Server Configuration
PORT=3001

# Anam AI Digital Human Guide Credentials
# Obtain from https://lab.anam.ai
ANAM_API_KEY=YOUR_ANAM_API_KEY_HERE
ANAM_PERSONA_ID=YOUR_ANAM_PERSONA_ID_HERE

# Google Gemini API Key for dynamic AI story generation and interactive Game Master chat
# (Optional: Wanderlore includes rich Kozhikode-verified local lore and fallback chat even without an API key)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Supabase PostgreSQL Database Configuration
# Obtain from https://supabase.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Real-World Map API Configuration
# Default: High-performance OpenStreetMap + Esri routing is 100% Free & Built-In (no API key required).
# Optional: To use Google Maps JavaScript API or Mapbox GL Vector Tiles:
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE
VITE_MAPBOX_TOKEN=YOUR_MAPBOX_TOKEN_HERE

